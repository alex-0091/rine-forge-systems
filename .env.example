# ============================================================
# RINE FORGE SYSTEMS — CONFIGURATION TEMPLATE (.env.example)
# ============================================================
# Copy this file to .env and configure the appropriate values.
# NEVER commit production secrets or passwords to version control.
# ============================================================

# ============================================================
# 1. PUBLIC CONFIG (Client-Visible / Operational Metadata)
# ============================================================
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
# Comma-separated list of permitted origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://rine-forge-systems.vercel.app

# ============================================================
# 2. SERVER-ONLY CONFIG (Privileged Secrets & Core Infrastructure)
# ============================================================
# REQUIRED in production: Generate via `openssl rand -hex 32`
SECRET_KEY=replace_with_a_secure_random_64_char_hex_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL:
# Local development default: sqlite+aiosqlite:///./outreach_ai.db
# Production PostgreSQL example: postgresql+asyncpg://user:password@host:5432/rine_forge_db
DATABASE_URL=sqlite+aiosqlite:///./outreach_ai.db

# Master Operating Safety Controls
DRY_RUN=True
AUTO_REPLY_ENABLED=False
GLOBAL_KILL_SWITCH=False

# Outbound Rate Limits
MAX_DAILY_EMAILS=50
MAX_HOURLY_EMAILS=10
MIN_SEND_DELAY_SECONDS=180
MAX_SEND_DELAY_SECONDS=600
SENDING_HOURS_START=9
SENDING_HOURS_END=17
SENDING_TIMEZONE=UTC
DEFAULT_LEAD_THRESHOLD=75
DEFAULT_COUNTRY=USA

# ============================================================
# 3. OPTIONAL INTEGRATIONS (AI, Email, Channels)
# ============================================================
# --- AI Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
GEMINI_API_KEY=
LLM_PROVIDER=auto
DEFAULT_MODEL=gpt-4o-mini
REASONING_MODEL=gpt-4o

# --- Email Infrastructure (Gmail SMTP or Relay) ---
EMAIL_PROVIDER=dry_run
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# --- Sender & Agency Identity ---
SENDER_NAME=Alex Rine
SENDER_EMAIL=alexrine691@gmail.com
SENDER_COMPANY=Rine Forge Systems
SENDER_PHYSICAL_ADDRESS=Rine Forge Systems, 100 Innovation Way, Suite 400, Austin, TX & Global
REPLY_TO_EMAIL=alexrine691@gmail.com
ESCALATION_EMAIL_ALERT=True
ALERT_RECIPIENT_EMAIL=alexrine691@gmail.com

# --- Meta WhatsApp Cloud API ---
META_VERIFY_TOKEN=rine_forge_whatsapp_verify_token_2026
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_API_VERSION=v21.0
