# ==========================================
# RINE FORGE SYSTEMS — PRODUCTION ENV CONFIG
# ==========================================

# --- AI & LLM Settings ---
GEMINI_API_KEY=
LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-1.5-flash
REASONING_MODEL=gemini-1.5-pro

# --- Live Outreach & Operating Mode ---
# Change DRY_RUN to False when you want to send real live emails through Gmail
DRY_RUN=False
EMAIL_PROVIDER=smtp
GLOBAL_KILL_SWITCH=False
AUTO_REPLY_ENABLED=True

# --- Official Email & SMTP Configuration (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alexrine691@gmail.com
# Paste your 16-character Google App Password below (from: https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=
SMTP_USE_TLS=True

# --- Sender & Agency Identity ---
SENDER_NAME=Alex Rine
SENDER_EMAIL=alexrine691@gmail.com
SENDER_COMPANY=Rine Forge Systems
SENDER_PHYSICAL_ADDRESS=Rine Forge Systems, 100 Innovation Way, Suite 400, Austin, TX & Global
REPLY_TO_EMAIL=alexrine691@gmail.com
ALERT_RECIPIENT_EMAIL=alexrine691@gmail.com

# --- Rate Limiting & Safe Sending ---
MAX_DAILY_EMAILS=45
MAX_HOURLY_EMAILS=8
MIN_SEND_DELAY_SECONDS=180
MAX_SEND_DELAY_SECONDS=600

# --- Meta WhatsApp Cloud API ---
# Set the exact verify token you enter into the Meta App Dashboard webhook settings
META_VERIFY_TOKEN=rine_forge_whatsapp_verify_token_2026
# Permanent or system user access token from Meta App Dashboard
META_ACCESS_TOKEN=
# Phone Number ID from WhatsApp Business Accounts settings
META_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WABA ID)
META_WABA_ID=
# Graph API Version
META_API_VERSION=v21.0

